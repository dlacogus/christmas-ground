// Cloudflare Workers 설정 (무료 플랜).
// - 정적 파일: dist/ 를 assets로 내보낸다.
// - /ws 요청만 Worker 코드(src/worker/index.ts)로 가서 Durable Object 'Plaza'(실시간 광장, 하나뿐)에 닿는다.
// - Durable Object는 무료 플랜에서 쓸 수 있는 SQLite 저장소 방식(new_sqlite_classes)으로 만든다.
{
  "name": "christmas-square",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/ws"]
  },
  "durable_objects": {
    "bindings": [{ "name": "PLAZA", "class_name": "Plaza" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Plaza"] }]
}
