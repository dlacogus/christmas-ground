{
  "name": "christmas-plaza",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc && tsc -p tsconfig.worker.json && vite build",
